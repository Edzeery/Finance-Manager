.env.example
APP_NAME="Finance Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_CURRENCY=USD
APP_CURRENCY_POSITION=left
APP_REGISTRATION_ENABLED=true

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ─── Logging ───────────────────────────────────────
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=

# ─── Database ──────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_manager
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SSLMODE=prefer

# ─── Session ───────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_EXPIRE_ON_CLOSE=false

# ─── Cache & Queue ─────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
CACHE_STORE=database
CACHE_PREFIX=fm_

# ─── Mail ──────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=

# ─── AWS S3 (للنسخ الاحتياطية) ─────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Payment Gateways ──────────────────────────────
PAYMENT_GATEWAY=cash
DEFAULT_CURRENCY=DZD
WEBHOOK_SECRET=

# Chargily (DZD — Algerian)
CHARGILY_MODE=test
CHARGILY_PUBLIC_KEY=
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_URL=

# Baridimob
BARIDIMOB_ENABLED=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_SANDBOX=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Wise (Bank Transfer)
WISE_API_KEY=
WISE_SANDBOX=true
WISE_RECIPIENT_ACCOUNT_ID=

# Payoneer
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_PROGRAM_ID=
PAYONEER_SANDBOX=true

# RedotPay (Crypto)
REDOTPAY_WALLET_ADDRESS=

# ─── Noest (Logistics / Courier) ────────────────────
NOEST_BASE_URL=
NOEST_API_TOKEN=
NOEST_USER_GUID=

# ─── Redis (optional, for cache/queue in production) ─
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Backup ──────────────────────────────────────────
BACKUP_DISK=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=admin@example.com

# ─── Finance ─────────────────────────────────────────
FINANCE_CURRENCY=DZD
FINANCE_CURRENCY_SYMBOL="د.ج"
FINANCE_LOCALE=ar
FINANCE_DATE_FORMAT="Y/m/d"
FINANCE_DECIMAL_PLACES=2
FINANCE_THOUSANDS_SEPARATOR=,
FINANCE_DECIMAL_SEPARATOR=.

# ─── Zakat ───────────────────────────────────────────
ZAKAT_GOLD_PRICE=0
ZAKAT_SILVER_PRICE=0

# ─── 2FA / OTP ───────────────────────────────────────
OTP_ENABLED=true
OTP_LIFETIME=0
OTP_KEEP_ALIVE=true

# ─── Sentry (Error Tracking) ─────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ─── Sanctum (API Auth) ──────────────────────────────
SANCTUM_STATEFUL_DOMAINS="${APP_URL}"
SANCTUM_TOKEN_PREFIX=fmt_

VITE_APP_NAME="${APP_NAME}"

# ─── Webhook Signing Secrets ──────────────────────────
PAYPAL_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
WISE_WEBHOOK_SECRET=
PAYONEER_WEBHOOK_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=""
