APP_NAME="Finance Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finance_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
CACHE_PREFIX=fm_

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── Localization ──────────────────────────────
APP_CURRENCY=DZD
APP_CURRENCY_POSITION=right

# ─── Payment Gateways ──────────────────────────
PAYMENT_GATEWAY=cash
DEFAULT_CURRENCY=DZD
WEBHOOK_SECRET=


# Chargily (DZD — Algerian)
CHARGILY_MODE=test
CHARGILY_PUBLIC_KEY=test_pk_dbQ3NH4EuAM3vGIE0ZQtrfXTeQD7oUJ1ezbDE2qy
CHARGILY_SECRET_KEY=test_sk_hBWHfuX8Jc8b7YA87VvwhvdvX57Z0DoXtzLpVSIk
CHARGILY_WEBHOOK_URL=https://apoplectoid-supervastly-dinah.ngrok-free.dev/payment/webhook/chargily



# Baridimob
BARIDIMOB_ENABLED=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_SANDBOX=true

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_SANDBOX=true

# Wise (Bank Transfer)
WISE_API_KEY=
WISE_SANDBOX=true
WISE_RECIPIENT_ACCOUNT_ID=

# Payoneer
PAYONEER_CLIENT_ID=
PAYONEER_CLIENT_SECRET=
PAYONEER_PROGRAM_ID=
PAYONEER_SANDBOX=true

# RedotPay (Crypto)
REDOTPAY_WALLET_ADDRESS=

# Noest (Logistics / Courier)
NOEST_BASE_URL=https://app.noest-dz.com/api/public
NOEST_API_TOKEN=
NOEST_USER_GUID=

# ─── Finance ───────────────────────────────────
FINANCE_CURRENCY=DZD
FINANCE_CURRENCY_SYMBOL="د.ج"
FINANCE_LOCALE=ar
FINANCE_DATE_FORMAT="Y/m/d"
FINANCE_DECIMAL_PLACES=2
FINANCE_THOUSANDS_SEPARATOR=,
FINANCE_DECIMAL_SEPARATOR=.

# ─── Zakat ─────────────────────────────────────
ZAKAT_GOLD_PRICE=0
ZAKAT_SILVER_PRICE=0

# ─── 2FA / OTP ────────────────────────────────
OTP_ENABLED=true
OTP_LIFETIME=30
OTP_KEEP_ALIVE=true

# ─── Sentry (Error Tracking) ───────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Sanctum (API Auth) ────────────────────────
SANCTUM_STATEFUL_DOMAINS="${APP_URL}"
SANCTUM_TOKEN_PREFIX=fmt_

# ─── Webhook Signing Secrets ───────────────────
PAYPAL_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
WISE_WEBHOOK_SECRET=
PAYONEER_WEBHOOK_SECRET=

# ─── CORS ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=""

# ─── Expiry / Grace ────────────────────────────
EXPIRY_REMINDER_DAYS=5
GRACE_PERIOD_DAYS=7
DOWNGRADE_MIN_DAYS=7
